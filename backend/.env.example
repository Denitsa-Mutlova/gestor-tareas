# Variables de entorno del backend (perfil "prod").
# Copia este fichero como .env y pon tus valores. No subas el .env real a Git.
# Con docker compose ya vienen definidas en docker-compose.yml.

# Base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gestor_tareas
PGUSER=tu_usuario
PGPASSWORD=tu_contraseña

# Servidor
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# URL del frontend permitida por CORS
FRONTEND_URL=http://localhost:3000
